# Polymarket Bot Configuration
# Copy this to .env and fill in your values

# Your Polygon wallet private key (hex, with or without 0x prefix)
POLYMARKET_PRIVATE_KEY=

# Your funder/proxy wallet address (required for Polymarket.com accounts)
# Find this on polymarket.com -> Settings -> your deposit address
POLYMARKET_FUNDER=

# Signature type: 0=EOA (direct wallet), 1=POLY_PROXY (polymarket.com account)
POLYMARKET_SIG_TYPE=1
